<ci:TriggerSettingsControlBase x:Class="ClassIsland.Controls.TriggerSettingsControls.OnBreakingTimeTriggerSettingsControl"
                               x:TypeArguments="triggers:OnBreakingTimeTriggerSettings"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Controls.TriggerSettingsControls"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:triggers="clr-namespace:ClassIsland.Models.Automation.Triggers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      >

    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:OnBreakingTimeTriggerSettingsControl}}"
          RowDefinitions="Auto,Auto" Margin="0 4">
        <CheckBox Grid.Row="0" Content="仅在指定科目下课时触发"
                  IsChecked="{Binding Settings.IsSubjectFilterEnabled, Mode=TwoWay}"/>
        <ComboBox Grid.Row="1" Margin="0 6 0 0"
                  IsVisible="{Binding Settings.IsSubjectFilterEnabled}"
                  ItemsSource="{Binding ProfileService.Profile.Subjects}"
                  SelectedValue="{Binding Settings.SelectedSubjectId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Key}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Value.Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</ci:TriggerSettingsControlBase>
